# GitHub OAuth (required for authentication)
AUTH_GITHUB_ID=your_github_app_id
AUTH_GITHUB_SECRET=your_github_app_secret

# GitHub Token (for fetching repo updates)
GITHUB_TOKEN=your_github_token

# Database Configuration
DATABASE_URL=postgresql://meetingbot:secure_password@postgres:5432/meetingbot

# Docker Compose Deployment Mode
DEPLOYMENT_MODE=docker-compose
NODE_ENV=production

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your-super-secret-jwt-secret-key-change-this-in-production
AUTH_TRUST_HOST=true
NEXTAUTH_TRUST_HOST=true

# AWS S3 / MinIO Configuration
AWS_BUCKET_NAME=meetingbot-recordings
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true

# MinIO Credentials (must match docker-compose.yml)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# Docker Configuration
DOCKER_HOST=/var/run/docker.sock
BOT_NETWORK=meetingbot_network

# Additional configuration (optional)
# Set to 'true' to run with development settings
DEBUG_MODE=false

# Transcription providers (optional)
# TRANSCRIPTION_PROVIDER can be: openai | assemblyai | whisper-self-hosted | sarvam
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=your_assemblyai_key
SARVAM_API_KEY=your_sarvam_api_key
OPENAI_API_KEY=your_openai_key

# ---------------------------------------------------------------------------
# Gemini Live Voice Assistant (Mode A)
# ---------------------------------------------------------------------------
# Run ./setup-pulse.sh on the host before `docker compose up` so BotSpeaker
# and BotMic PulseAudio devices exist and the /run/pulse socket is reachable.
PIPELINE_MODE=gemini_live
GEMINI_API_KEY=AIzaSyAaDbuyJgZkYXYtArPkflUXtW2WC2BiXV4
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
PROACTIVE_AUDIO=true
AUDIO_CHUNK_SECONDS=5
TRIGGER_PHRASE=hey bot
BOT_NAME=AI Assistant
PULSE_SINK=BotSpeaker
PULSE_SOURCE=BotMic
# Host directory containing the PulseAudio UNIX socket (`native`).
# Auto-detected by setup-pulse.sh; on user-mode PulseAudio this is
# usually /run/user/<uid>/pulse. Leave at the default for uid 1000.
PULSE_RUNTIME_PATH=/run/user/1000/pulse
SELF_MUTE_ENABLED=true
ORCHESTRATOR_PORT=8080
# Host-side port mapped to the orchestrator container (change if 8080 is taken on the host).
ORCHESTRATOR_HOST_PORT=8090
ORCHESTRATOR_URL=http://orchestrator:8080
SYSTEM_PROMPT_FILE=prompts/gemini_live.txt
